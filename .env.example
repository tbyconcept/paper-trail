# Copy this file to .env.local (gitignored) and fill in your Supabase
# project's values: Project Settings → API in the Supabase dashboard.
# EXPO_PUBLIC_ vars are inlined into the client bundle at build time, so
# only ever put the *anon* public key here — never the service role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
